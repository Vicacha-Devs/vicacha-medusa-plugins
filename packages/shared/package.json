{
  "name": "@vicacha-devs/medusa-shared-admin",
  "version": "0.0.1",
  "description": "Shared admin components, hooks, and utilities for Vicacha Devs Medusa plugins",
  "private": true,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.dts.json",
    "dev": "vite build --watch"
  },
  "exports": {
    "./admin": {
      "types": "./dist/index.d.ts",
      "import": "./dist/admin.mjs",
      "default": "./dist/admin.mjs"
    },
    "./admin/*": {
      "import": "./src/admin/*.ts",
      "default": "./src/admin/*.ts"
    }
  },
  "peerDependencies": {
    "@medusajs/framework": "*",
    "@medusajs/icons": "*",
    "@medusajs/ui": "*",
    "@radix-ui/react-label": "*",
    "@radix-ui/react-popover": "*",
    "@radix-ui/react-radio-group": "*",
    "@radix-ui/react-slot": "*",
    "@tanstack/react-query": "*",
    "@tanstack/react-table": "*",
    "@uiw/react-json-view": "*",
    "cmdk": "*",
    "date-fns": "*",
    "i18next": "*",
    "lodash": "*",
    "react": "*",
    "react-hook-form": "*",
    "react-i18next": "*",
    "react-router-dom": "*",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@medusajs/dashboard": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/ui": "4.2.0",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.64.2",
    "@tanstack/react-table": "8.20.5",
    "@types/lodash": "^4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@uiw/react-json-view": "2.0.0-alpha.43",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "i18next": "*",
    "lodash": "4.18.1",
    "react": "18.2.0",
    "react-hook-form": "7.85.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "vite": "5.2.11",
    "vite-plugin-dts": "^5.0.3"
  }
}

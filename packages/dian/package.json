{
  "name": "@vicacha-devs/medusa-plugin-dian",
  "version": "0.0.1",
  "description": "Colombian DIAN Electronic Invoicing (Facturación Electrónica DIAN Anexo Técnico 1.9, Resolución 000165) plugin for Medusa v2: UBL 2.1 XML, CUFE/CUDE SHA-384, XAdES-EPES digital signature, DIAN SOAP Web Services & Pluggable Providers (Siigo, Alegra, Dataico, FacturaTech), Credit/Debit Notes, POS Equivalent (Tipo 20), B2B Legal Client validation via @vicacha-devs/medusa-plugin-b2b, and PDF Representación Gráfica via @vicacha-devs/medusa-plugin-documents.",
  "author": "Vicacha Devs",
  "license": "MIT",
  "files": [
    ".medusa/server",
    "src",
    "src/modules/dian/migrations/*.js",
    "src/modules/dian/migrations/.snapshot-*.json",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./.medusa/server/src/index.js",
      "require": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./hooks": {
      "import": "./src/hooks/index.ts",
      "default": "./.medusa/server/src/hooks/index.js"
    },
    "./sdk": {
      "import": "./src/sdk/index.ts",
      "default": "./.medusa/server/src/sdk/index.js"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "default": "./.medusa/server/src/types/index.js"
    },
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-dian",
    "dian",
    "colombia",
    "facturacion-electronica",
    "ubl-2.1",
    "cufe",
    "cude",
    "xades-epes",
    "pos-electronico",
    "nota-credito",
    "nota-debito",
    "b2b",
    "documents"
  ],
  "scripts": {
    "build": "medusa plugin:build && tsc-alias -p tsconfig.json",
    "publish:local": "medusa plugin:publish",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "prepublishOnly": "medusa plugin:build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./src/__tests__/register-ts-resolver.mjs --test src/__tests__/*.spec.ts",
    "clean": "rm -rf .medusa node_modules"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.7.1",
    "@medusajs/admin-sdk": "2.21.0",
    "@medusajs/admin-shared": "2.21.0",
    "@medusajs/cli": "2.21.0",
    "@medusajs/core-flows": "2.21.0",
    "@medusajs/dashboard": "2.21.0",
    "@medusajs/framework": "2.21.0",
    "@medusajs/icons": "2.21.0",
    "@medusajs/js-sdk": "2.21.0",
    "@medusajs/medusa": "2.21.0",
    "@medusajs/test-utils": "2.21.0",
    "@medusajs/types": "2.21.0",
    "@medusajs/ui": "4.2.4",
    "@mikro-orm/migrations": "6.4.3",
    "@swc/core": "1.7.28",
    "@types/node": "20.0.0",
    "@types/react": "18.3.2",
    "@types/react-dom": "18.2.25",
    "@vicacha-devs/medusa-plugin-b2b": "workspace:*",
    "@vicacha-devs/medusa-plugin-documents": "workspace:*",
    "jiti": "2.0.0",
    "prop-types": "15.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.85.0",
    "react-i18next": "15.4.1",
    "react-router-dom": "6.30.0",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.9.2",
    "typescript": "5.6.2",
    "vite": "7.3.6"
  },
  "peerDependencies": {
    "@hookform/resolvers": "5.7.1",
    "@medusajs/admin-sdk": "2.21.0",
    "@medusajs/admin-shared": "2.21.0",
    "@medusajs/cli": "2.21.0",
    "@medusajs/core-flows": "2.21.0",
    "@medusajs/framework": "2.21.0",
    "@medusajs/icons": "2.21.0",
    "@medusajs/js-sdk": "2.21.0",
    "@medusajs/medusa": "2.21.0",
    "@medusajs/test-utils": "2.21.0",
    "@medusajs/types": "2.21.0",
    "@medusajs/ui": "4.2.4",
    "@vicacha-devs/medusa-plugin-b2b": ">=0.0.1",
    "@vicacha-devs/medusa-plugin-documents": ">=0.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "7.85.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^6.20.0",
    "zod": "4.2.0"
  },
  "peerDependenciesMeta": {
    "@vicacha-devs/medusa-plugin-b2b": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.20.0"
}

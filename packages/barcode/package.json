{
  "name": "@vicacha-devs/medusa-plugin-barcode",
  "version": "0.0.1",
  "description": "Unified 4-in-1 Barcode, GS1, Dynamic QR, Multi-Provider GTIN Lookup, Thermal/Sheet Label Printing (HTML/SVG & ZPL II), Anti-Counterfeit Verification & Warehouse Stock-Take Scanner plugin for Medusa v2.",
  "author": "Medusa Barcode Contributors",
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "import": "./.medusa/server/src/index.js",
      "require": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    },
    "./package.json": "./package.json",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./ui": {
      "types": "./.medusa/server/src/ui/index.d.ts",
      "import": "./.medusa/server/src/ui/index.js",
      "require": "./.medusa/server/src/ui/index.js",
      "default": "./.medusa/server/src/ui/index.js"
    },
    "./hooks": {
      "types": "./.medusa/server/src/hooks/index.d.ts",
      "import": "./.medusa/server/src/hooks/index.js",
      "require": "./.medusa/server/src/hooks/index.js",
      "default": "./.medusa/server/src/hooks/index.js"
    },
    "./sdk": {
      "types": "./.medusa/server/src/sdk/index.d.ts",
      "import": "./.medusa/server/src/sdk/index.js",
      "require": "./.medusa/server/src/sdk/index.js",
      "default": "./.medusa/server/src/sdk/index.js"
    },
    "./workflows": {
      "types": "./.medusa/server/src/workflows/index.d.ts",
      "import": "./.medusa/server/src/workflows/index.js",
      "require": "./.medusa/server/src/workflows/index.js",
      "default": "./.medusa/server/src/workflows/index.js"
    },
    "./modules/*": {
      "types": "./.medusa/server/src/modules/*/index.d.ts",
      "default": "./.medusa/server/src/modules/*/index.js"
    },
    "./.medusa/server/src/modules/*": {
      "types": "./.medusa/server/src/modules/*/index.d.ts",
      "default": "./.medusa/server/src/modules/*/index.js"
    },
    "./*": {
      "types": "./.medusa/server/src/*.d.ts",
      "default": "./.medusa/server/src/*.js"
    }
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-barcode",
    "barcode",
    "ean13",
    "upc",
    "gs1",
    "gs1-128",
    "qr-code",
    "zpl",
    "label-printing",
    "inventory-count",
    "pos",
    "open-food-facts"
  ],
  "scripts": {
    "build": "medusa plugin:build && tsc-alias -p tsconfig.json",
    "publish:local": "medusa plugin:publish",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "prepublishOnly": "medusa plugin:build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./src/__tests__/register-ts-resolver.mjs --test src/__tests__/*.spec.ts"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.7.1",
    "@medusajs/admin-sdk": "2.21.0",
    "@medusajs/admin-shared": "2.21.0",
    "@medusajs/cli": "2.21.0",
    "@medusajs/core-flows": "2.21.0",
    "@medusajs/dashboard": "2.21.0",
    "@medusajs/framework": "2.21.0",
    "@medusajs/icons": "2.21.0",
    "@medusajs/js-sdk": "2.21.0",
    "@medusajs/medusa": "2.21.0",
    "@medusajs/test-utils": "2.21.0",
    "@medusajs/types": "2.21.0",
    "@medusajs/ui": "4.2.4",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@swc/core": "1.7.28",
    "@tanstack/react-table": "8.20.5",
    "@types/node": "20.0.0",
    "@types/react": "18.3.2",
    "@types/react-dom": "18.2.25",
    "@vicacha-devs/medusa-shared-admin": "workspace:*",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "jiti": "2.0.0",
    "lodash": "4.18.1",
    "prop-types": "15.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.9.2",
    "typescript": "5.6.2",
    "vite": "7.3.6"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.21.0",
    "@medusajs/admin-shared": "2.21.0",
    "@medusajs/core-flows": "2.21.0",
    "@medusajs/framework": "2.21.0",
    "@medusajs/icons": "2.21.0",
    "@medusajs/js-sdk": "2.21.0",
    "@medusajs/medusa": "2.21.0",
    "@medusajs/types": "2.21.0",
    "@medusajs/ui": "4.2.4",
    "@tanstack/react-table": "8.20.5",
    "@uiw/react-json-view": "2.0.0-alpha.43",
    "react-hook-form": "7.85.0",
    "zod": "4.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
